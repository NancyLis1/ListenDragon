APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:////data/listendragon.db
DATA_ROOT=/data
MAX_UPLOAD_MB=500
MAX_VIDEO_MINUTES=60
WORKER_POLL_SECONDS=2
WORKER_CONCURRENCY=1
WORKER_LEASE_SECONDS=1800
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
CORS_ORIGINS=http://localhost:5173,https://nancylis1.github.io

ASR_MODEL=base
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
CHUNK_MIN_CHARS=300
CHUNK_TARGET_CHARS=400
CHUNK_MAX_CHARS=500
CHUNK_OVERLAP_CHARS=50
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# 可对接 Ollama 或任意 OpenAI-compatible 服务；不要提交真实密钥。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 前端构建变量；项目站点路径与仓库名保持一致。
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_BASE_PATH=/ListenDragon/
